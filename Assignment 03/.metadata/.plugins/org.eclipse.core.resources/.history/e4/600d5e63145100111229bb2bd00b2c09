#include "stm32f446xx.h"
#include<stdint.h>
#include<stdio.h>
#include<string.h>
#define BME280_I2C_ADDR 0x76 //mainlt the reg addr
#define BME280_REG_ID       0xD0
#define BME280_REG_RESET    0xE0
#define BME280_REG_CTRL_HUM 0xF2
#define BME280_REG_CTRL_MEAS 0xF4
#define BME280_REG_CONFIG   0xF5
#define BME280_REG_DATA     0xF7
#define BME280_CHIP_ID      0x60

//Calibration coefficients (loaded once at startup) ────────────────────── */
static uint16_t dig_T1;
static int16_t  dig_T2, dig_T3;
static uint16_t dig_P1;
static int16_t  dig_P2, dig_P3, dig_P4, dig_P5;
static int16_t  dig_P6, dig_P7, dig_P8, dig_P9;
static uint8_t  dig_H1, dig_H3;
static int16_t  dig_H2, dig_H4, dig_H5;
static int8_t   dig_H6;

static int32_t  t_fine;          /* shared between temp and pressure comp.   */

/* ── ISR flag — set every 1 second by TIM6 interrupt ─────────────────────── */
volatile uint8_t read_flag = 0;

void Tim6_Init(void)
{
	RCC->APB1ENR |= RCC_APB1ENR_TIM6EN;
		__NOP();
		__NOP();
		TIM6->CR1 &= ~TIM_CR1_CEN;
		TIM6->PSC=89;
		TIM6->ARR=~0x0;
		TIM6->EGR |=TIM_EGR_UG;
		TIM6->SR=0;
		TIM6->CR1 |=TIM_CR1_CEN;
}
void delay_us(uint16_t us)
{
	uint16_t start= (uint16_t)TIM6->CNT;
	while((uint16_t) TIM6->CNT -start <us);
}
void delay_ms(uint32_t  ms)
{
	for(int i=0;i<ms;i++)delay_us(1000);
}
void PLL_Config(void)
{
    /* 1. Enable HSI (16 MHz) */
    RCC->CR |= RCC_CR_HSION;
    while (!(RCC->CR & RCC_CR_HSIRDY));  // Wait until HSI ready

    /* 2. Configure PLL: HSI/16 * 180 / 2 = 90 MHz */
    RCC->PLLCFGR = (16 << RCC_PLLCFGR_PLLM_Pos)   // PLLM = 16
                 | (180 << RCC_PLLCFGR_PLLN_Pos)  // PLLN = 180
                 | (0 << RCC_PLLCFGR_PLLP_Pos)    // PLLP = 2 (00b)
                 | (4 << RCC_PLLCFGR_PLLQ_Pos)    // PLLQ = 4 (USB/SDIO)
                 | RCC_PLLCFGR_PLLSRC_HSI;        // Source = HSI

    /* 3. Enable PLL */
    RCC->CR |= RCC_CR_PLLON;
    while (!(RCC->CR & RCC_CR_PLLRDY));  // Wait until PLL ready

    /* 4. Configure Flash latency (2 WS for 90 MHz) */
    FLASH->ACR = FLASH_ACR_ICEN | FLASH_ACR_DCEN | FLASH_ACR_LATENCY_2WS;

    /* 5. Set prescalers: AHB=1, APB1=2, APB2=1 */
    RCC->CFGR = RCC_CFGR_HPRE_DIV1
              | RCC_CFGR_PPRE1_DIV2
              | RCC_CFGR_PPRE2_DIV1;

    /* 6. Switch SYSCLK to PLL */
    RCC->CFGR |= RCC_CFGR_SW_PLL;
    while ((RCC->CFGR & RCC_CFGR_SWS) != RCC_CFGR_SWS_PLL);  // Wait until PLL is active
}

void USART2_Init(void)
{
    /* 1. Enable Clocks */
    RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN;      // Enable GPIOA clock
    RCC->APB1ENR |= RCC_APB1ENR_USART2EN;     // Enable USART2 clock
    __NOP();
    __NOP();

    /* 2. Configure PA2 and PA3 as Alternate Function AF7 (USART2) */
    /* Alternate Function Mode */
    GPIOA->MODER &= ~((3UL<<(2*2)) | (3UL<<(3*2)));
    GPIOA->MODER |=  ((2UL<<(2*2)) | (2UL<<(3*2)));

    /* Select AF7 */

    GPIOA->AFR[0] &= ~((0xF<<(4*2)) | (0xF<<(4*3)));
    GPIOA->AFR[0] |=  ((7<<(4*2))  | (7<<(4*3)));

    /* Push-pull */
    GPIOA->OTYPER &= ~((1UL<<2) | (1UL<<3));

    /* Very high speed */
    GPIOA->OSPEEDR |= ((3UL<<(2*2)) | (3UL<<(3*2)));

    /* No pull-up / pull-down */
    GPIOA->PUPDR &= ~((3UL<<(2*2)) | (3UL<<(3*2)));

    /* 3. Configure Baud Rate */
    /*
       USARTDIV = 45000000 / (16 * 115200)
                ≈ 24.4140625

       Mantissa = 24
       Fraction = 0.4140625 * 16 ≈ 6
    */
    USART2->BRR = (24 << 4) | 6;

    /* 4. Enable USART, TX and RX */
    USART2->CR1 |= USART_CR1_TE | USART_CR1_RE;
    USART2->CR1 |= USART_CR1_UE;
}
void USART2_SendChar(char c)
{
	while(!(USART2->SR & USART_SR_TXE))
	{
		//while txe is empty it will wait
	}
		USART2->DR=(uint8_t)c;
}
void USART2_SendString(char *str)
{
	while (*str) USART2_SendChar(*str++);
}
uint8_t USART2_RevChar(void)
{
	while(!(USART2->SR & USART_SR_RXNE));
	return (uint8_t)(USART2->DR & 0XFF);
}

void GPIO_Config(void)
{
	RCC->AHB1ENR |=RCC_AHB1ENR_GPIOBEN;
	GPIOB->MODER &=~((3UL<<12) | (3UL<<14));
	GPIOB->MODER|=((2UL<<12) | (2UL<<14));
	GPIOB->OTYPER &=~((1UL<<6) |(1UL<<7));
	GPIOB->OTYPER|=(1UL<<6) | (1UL<<7);
	GPIOB->OSPEEDR &=~((3UL<<12) | (3UL<<14));
	GPIOB->OSPEEDR |=((1UL<<12) | (1UL<<14));
	GPIOB->PUPDR &= ~((3UL<<12) | (3UL<<14));
	GPIOB->PUPDR |=((1UL<<12) | (1UL<<14));
	GPIOB->AFR[0] &=~((15UL<<24) | (15UL<<28));
	GPIOB->AFR[0] |=((4UL<<24) |(4UL<<28));
}

void I2C1_INIT(void)
{
	RCC->APB1ENR |=1<<21;//i2c1 clock enable
	__NOP();
	__NOP();
	RCC->APB1RSTR |=(1<<21);//SETTING BIT 21
	RCC->APB1RSTR &= ~(1<<21); //RESETING THE 21 PIN
	I2C1->CR1=0; //FIRST DIABLING THE I2C1
	I2C1->CR2=45; //45 MHZ IN APB1
	I2C1->CCR=225; //100KHZ STANDARD MODE BTW
	I2C1->TRISE =46 ;
	I2C1->CR1|=(1<<0);//FINALLY EANBLING BY I2C1 PE=1
}
void I2C1_Start(void)
{
	I2C1->CR1 |=(1<<8);//ENABLING START BIT
	while(!(I2C1->SR1 & (1<<0)));
}
void I2C1_Writereg(uint8_t reg, uint8_t data)
{
	I2C1->CR1 |=(1<<8); //Enabling the start bit
	while(!(I2C1->CR1 & (1<<0))); //WAITNG FOR STARTBIT STATUS
	I2C1->DR = (BME280_I2C_ADDR <<1) |0; //0 for wrinting command
	while(!(I2C1->SR1 & (1<<1))); //waiting for the addr bit
	(void)I2C1->SR2 ; //CLEARING THE ADDR FLAG -->only read
	I2C1->DR =reg; //sending reg addr
	while(!(I2C1->SR1 & (1<<7))); //WAIT FOR TXE=1
	I2C1->DR= data;
	while(!(I2C1->SR1 & (1<<2))); //BTF=1  transfer finished
	I2C1->CR1 |=(1<<9); //wait for the stop bit

}

void I2C1_Redreg(uint8_t reg, uint8_t *buf, uint8_t len)
{
	I2C1->CR1 |=(1<<8); //Enabling the start bit
	while(!(I2C1->SR1 & (1<<0))); //WAITNG FOR STARTBIT STATUS
	I2C1->DR = (BME280_I2C_ADDR <<1) |0; //0 for wrinting command
	while(!(I2C1->SR1 & (1<<1))); //waiting for the addr bit
	(void)I2C1->SR2 ; //CLEARING THE ADDR FLAG
	I2C1->DR =reg; //sending reg addr
	while(!(I2C1->SR1 & (1<<2))); //BTF=1  transfer finished

	I2C1->CR1 |=(1<<10) | (1<<8); //Here 10 is ack=1 mainly then restart
	while(!(I2C1->SR1 & (1<<0)));
	I2C1->DR = (BME280_I2C_ADDR <<1) |1; //from slave , now will read data
	while(!(I2C1->SR1 & (1<<1)));
	I2C1->SR2=0 ;

	for(uint8_t i =0; i<len; i++)
	{
		if(i==len-1) I2C1->CR1 &= ~(1<<10); //giving nack mainly
		while(!(I2C1->SR1 & (1<<6))); //wait till rxne=1
		buf[i]=I2C1->DR; //per byte storing on buffer
	}
	I2C1->CR1 |=(1<<9);
}

/* =========================================================================
   8.  BME280 Calibration — read factory coefficients from sensor NVM
   ========================================================================= */
void BME280_ReadCalibration(void)
{
    uint8_t c[24];
    uint8_t h[7];

    /* Temperature and Pressure coefficients: registers 0x88–0x9F (24 bytes) */
    I2C1_Readreg(0x88, c, 24);

    dig_T1 = (uint16_t)((c[1]  << 8) | c[0]);
    dig_T2 = (int16_t) ((c[3]  << 8) | c[2]);
    dig_T3 = (int16_t) ((c[5]  << 8) | c[4]);
    dig_P1 = (uint16_t)((c[7]  << 8) | c[6]);
    dig_P2 = (int16_t) ((c[9]  << 8) | c[8]);
    dig_P3 = (int16_t) ((c[11] << 8) | c[10]);
    dig_P4 = (int16_t) ((c[13] << 8) | c[12]);
    dig_P5 = (int16_t) ((c[15] << 8) | c[14]);
    dig_P6 = (int16_t) ((c[17] << 8) | c[16]);
    dig_P7 = (int16_t) ((c[19] << 8) | c[18]);
    dig_P8 = (int16_t) ((c[21] << 8) | c[20]);
    dig_P9 = (int16_t) ((c[23] << 8) | c[22]);

    /* dig_H1: register 0xA1 (1 byte) */
    I2C1_Readreg(0xA1, &dig_H1, 1);

    /* Humidity coefficients: registers 0xE1–0xE7 (7 bytes) */
    I2C1_Readreg(0xE1, h, 7);
    dig_H2 = (int16_t)((h[1] << 8) | h[0]);
    dig_H3 = h[2];
    dig_H4 = (int16_t)((h[3] << 4) | (h[4] & 0x0F));
    dig_H5 = (int16_t)((h[5] << 4) | (h[4] >> 4));
    dig_H6 = (int8_t)h[6];
}

/* =========================================================================
   10. BME280 Compensation Formulas (Bosch datasheet, 32/64-bit integer)
   ========================================================================= */

/* Returns temperature in °C × 100  (e.g. 2345 = 23.45 °C)
   Also sets global t_fine used by pressure and humidity compensation.       */
int32_t BME280_CompTemp(int32_t adc_T)
{
    int32_t var1, var2;
    var1 = ((((adc_T >> 3) - ((int32_t)dig_T1 << 1))) * (int32_t)dig_T2) >> 11;
    var2 = (((((adc_T >> 4) - (int32_t)dig_T1) *
              ((adc_T >> 4) - (int32_t)dig_T1)) >> 12) * (int32_t)dig_T3) >> 14;
    t_fine = var1 + var2;
    return (t_fine * 5 + 128) >> 8;
}

/* Returns pressure in Pa × 256  (divide by 256 for Pa, by 25600 for hPa)  */
uint32_t BME280_CompPres(int32_t adc_P)
{
    int64_t var1, var2, p;
    var1 = (int64_t)t_fine - 128000;
    var2 = var1 * var1 * (int64_t)dig_P6;
    var2 = var2 + ((var1 * (int64_t)dig_P5) << 17);
    var2 = var2 + ((int64_t)dig_P4 << 35);
    var1 = ((var1 * var1 * (int64_t)dig_P3) >> 8) + ((var1 * (int64_t)dig_P2) << 12);
    var1 = ((((int64_t)1 << 47) + var1) * (int64_t)dig_P1) >> 33;
    if (var1 == 0) return 0;
    p    = 1048576 - adc_P;
    p    = (((p << 31) - var2) * 3125) / var1;
    var1 = ((int64_t)dig_P9 * (p >> 13) * (p >> 13)) >> 25;
    var2 = ((int64_t)dig_P8 * p) >> 19;
    p    = ((p + var1 + var2) >> 8) + ((int64_t)dig_P7 << 4);
    return (uint32_t)p;
}

/* Returns relative humidity in %RH × 1024  (divide by 1024 for %RH)       */
uint32_t BME280_CompHum(int32_t adc_H)
{
    int32_t v;
    v = t_fine - 76800;
    v = (((((adc_H << 14) - ((int32_t)dig_H4 << 20) - ((int32_t)dig_H5 * v))
            + 16384) >> 15) *
         (((((((v * (int32_t)dig_H6) >> 10) *
              (((v * (int32_t)dig_H3) >> 11) + 32768)) >> 10) + 2097152) *
           (int32_t)dig_H2 + 8192) >> 14));
    v -= (((((v >> 15) * (v >> 15)) >> 7) * (int32_t)dig_H1) >> 4);
    if (v < 0)         v = 0;
    if (v > 419430400) v = 419430400;
    return (uint32_t)(v >> 12);
}

void BME280_Init(void)
{
	uint8_t chip id=0;
	I2C1_Writereg(BME280_REG_RESET, 0X86);
	delay_ms(10);
	I2C1_Refreg(BME280_REG_ID, &chip_id, 1);
	if(chip_id != BME280_CHIP_ID)
	{
		USART2_SendString("BME280 not found (wrong chip ID)\r\n");
		while (1);
	}

	BME280_ReadCalibration();
	I2C1_Writerg(BME280_REG_CTRL_HUM, 0x01);
	I2C1_Writerg(BME280_REG_CTRL_MEAS, 0x57);
	I2C1_Writerg(BME280_REG_CONFIG, 0x10);

}

/* =========================================================================
   11. Read sensor, compensate, and transmit via USART2
   ========================================================================= */
void BME280_ReadAndPrint(void)
{
    uint8_t  raw[8];
    int32_t  adc_P, adc_T, adc_H;
    int32_t  temp_raw;
    uint32_t pres_raw, hum_raw;
    char     msg[128];

    /* Burst-read 8 bytes starting at 0xF7
       Layout: [press_msb, press_lsb, press_xlsb,
                temp_msb,  temp_lsb,  temp_xlsb,
                hum_msb,   hum_lsb]                                         */
    I2C1_ReadRegs(BME280_REG_DATA, raw, 8);

    /* Reconstruct 20-bit ADC values (bits [19:0])                          */
    adc_P = ((int32_t)raw[0] << 12) | ((int32_t)raw[1] << 4) | (raw[2] >> 4);
    adc_T = ((int32_t)raw[3] << 12) | ((int32_t)raw[4] << 4) | (raw[5] >> 4);
    /* Humidity is 16-bit                                                    */
    adc_H = ((int32_t)raw[6] << 8)  |  (int32_t)raw[7];

    /* Compensate — note: CompTemp must run first to populate t_fine        */
    temp_raw = BME280_CompTemp(adc_T);   /* °C × 100                        */
    pres_raw = BME280_CompPres(adc_P);   /* Pa × 256                        */
    hum_raw  = BME280_CompHum(adc_H);   /* %RH × 1024                      */

    /* Convert to human-readable floating-point units                        */
    float temp_C   = (float)temp_raw / 100.0f;
    float temp_F   = temp_C * 9.0f / 5.0f + 32.0f;
    float pres_hPa = ((float)pres_raw / 256.0f) / 100.0f;
    float hum_RH   = (float)hum_raw / 1024.0f;

    /* Transmit — BUG FIX: original had typo "UART_SendString(ms)" (missing 'g') */
    sprintf(msg, "[I2C] Temp:%.2fC/%.2fF Pres:%.2fhPa Hum:%.2f%%\r\n",
            temp_C, temp_F, pres_hPa, hum_RH);
    USART2_SendString(msg);
}

int main(void)
{
	PLL_Config();
	TIM6_Init();
	USART2_Init();
	GPIO_Config();
	I2C1_Init();
	BME280_Init();
	USART2_SendString("BME280 initialised. Reading every 1 s...\r\n");
	/* Switch TIM6 to 1-second periodic interrupt mode                       */
	TIM6_StartPeriodicISR();
	while(1)
	{
		if(read_flag)
		{
			read_flag=0;
			BME280_ReadAndPrint();
		}

		__WFI();
	}
}
