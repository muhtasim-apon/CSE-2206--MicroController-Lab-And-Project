void GPIO_TEST(void)
{
    RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN;

    GPIOA->MODER &= ~(3UL<<12);
    GPIOA->MODER |= (1UL<<12); // output mode

    while(1)
    {
        GPIOA->ODR |= (1<<6);  // ON
        for(int i=0;i<1000000;i++);

        GPIOA->ODR &= ~(1<<6); // OFF
        for(int i=0;i<1000000;i++);
    }
}
