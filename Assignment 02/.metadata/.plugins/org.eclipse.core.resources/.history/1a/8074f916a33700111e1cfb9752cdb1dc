#include"stm32f446xx.h"

void GPIO_TEST(void)
{
    RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN;

    GPIOA->MODER &= ~(3UL<<10);
    GPIOA->MODER |= (1UL<<10); // PA5 output

    while(1)
    {
        GPIOA->ODR |= (1<<5);  // ON
        for(int i=0;i<1000000;i++);

        GPIOA->ODR &= ~(1<<5); // OFF
        for(int i=0;i<1000000;i++);
    }
}

int main(void)
{
    GPIO_TEST();
}
